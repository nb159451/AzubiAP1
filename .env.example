# ---- Server ----
PORT=3001
# Sitzungs-Secret (optional; wird sonst automatisch erzeugt und in der DB gespeichert)
# JWT_SECRET=bitte-langes-zufaelliges-secret
# Speicherort der SQLite-Datenbank (Standard: server/data)
# DATA_DIR=./server/data
# Bei HTTPS-Betrieb auf true setzen
# COOKIE_SECURE=false

# ---- KI-Bewertung (Rechen- und Freitextaufgaben) ----
# auto | claude | gemini | none   (auto = nimmt den Anbieter, für den ein Key gesetzt ist)
AI_PROVIDER=auto

# Claude API (https://console.anthropic.com)
# ANTHROPIC_API_KEY=sk-ant-...
# CLAUDE_MODEL=claude-opus-5

# Google AI Studio (https://aistudio.google.com/apikey)
# GEMINI_API_KEY=AIza...
# GEMINI_MODEL=gemini-3.8-flash
# Ausweichmodelle bei Überlastung/Abschaltung (kommagetrennt)
# GEMINI_FALLBACK_MODELS=gemini-3.7-flash,gemini-3.6-flash,gemini-flash-latest
